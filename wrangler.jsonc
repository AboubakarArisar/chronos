{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chronos",
  "compatibility_date": "2026-11-17",
  // Static site only: the built Vite output, no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "chronos.aboubakarisar.tech", "custom_domain": true }
  ]
}
