{
 "about": "Prepared assets for the Chronos history globe. Everything here is local; the app must load from these paths, not from the web.",
 "earth_textures": {
  "folder": "assets/earth/",
  "files": {
   "earth-blue-marble.jpg": "4096x2048 daytime colour (NASA Blue Marble, via three-globe example, MIT package)",
   "earth-night.jpg": "4096x2048 city lights at night (NASA Black Marble, via three-globe)",
   "earth-topology.png": "2048x1024 elevation, white=high (bump/relief)",
   "earth-water.png": "1600x800 water mask, white=water",
   "earth_normal_2048.jpg": "2048x1024 tangent-space normal map (three.js examples, MIT)",
   "earth_specular_2048.jpg": "2048x1024 ocean shine mask, white=water",
   "earth_clouds_1024.png": "1024x512 cloud layer with alpha",
   "earth_day_4096.jpg": "4096x2048 alternative day texture (three.js)",
   "earth_night_4096.jpg": "4096x2048 alternative night texture (three.js)",
   "earth_bump_roughness_clouds_4096.jpg": "4096x2048 packed: R=bump, G=roughness, B=clouds (three.js)",
   "earth_atmos_2048.jpg": "2048x1024 older day texture (three.js)",
   "earth_lights_2048.png": "2048x1024 older night lights (three.js)"
  },
  "uv_convention": "Equirectangular. u=(lon+180)/360, v=(90-lat)/180 from the top, matching THREE.SphereGeometry. lat/lon to vector: phi=(lon+180)/360*2pi, theta=(90-lat)/180*pi, x=-cos(phi)sin(theta), y=cos(theta), z=sin(phi)sin(theta)."
 },
 "borders": {
  "source": "aourednik/historical-basemaps (GitHub), downloaded 2026-11-17",
  "license": "GPL-3.0 (data/borders/LICENSE). Shipping this data means the app should also be released under GPL-3.0 and credit the project.",
  "format": "GeoJSON, WGS84 lon/lat. One file per snapshot year. Polygon and MultiPolygon features.",
  "properties": {
   "NAME": "name of the country or region, use for labels",
   "SUBJECTO": "the power that rules it; group and colour by this (e.g. the four Mongol khanates in 1279 all have SUBJECTO \"Mongol Empire\")",
   "PARTOF": "larger cultural area",
   "BORDERPRECISION": "1 approximate, 2 moderate, 3 legally fixed; draw 1 as soft/blurred borders"
  },
  "quirks": [
   "Snapshots are irregular (54 total, 49 kept from 3000 BC). Between two snapshots, show the nearest earlier one or crossfade; always tell the user which map year is shown.",
   "Many features are cultural regions or peoples, not states (e.g. \"Siberian hunter-gatherers\", \"Bantu peoples\"). Draw them faint and do not give them big labels.",
   "Some rings cross the antimeridian (Russia, Pacific). Unwrap longitudes before drawing, and draw at x-W, x and x+W.",
   "Content reflects the dataset, which the author calls work in progress. Example: in 1279 the Song are already gone (conquered by Kublai that year).",
   "places.geojson from the repo was not available; city points must come from our own list."
  ],
